{
  "ConnectionStrings": {
    "Default": "Server=192.168.1.99;Port=3306;Database=st_tnt_liquor;User ID=root;Password=root;"
  },
  "Database": {
    "Provider": "MySql",
    "ServerVersion": "8.0.36"
  },
  "Jwt": {
    "Issuer": "ST.LiquorTNT",
    "Audience": "ST.LiquorTNT.Web",
    "SigningKey": "change-this-key-on-every-installation-min-32-chars"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "ST.LiquorTNT.Logging.AppJsonFormatter, ST.LiquorTNT.Logging" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/stliquortnt-.json",
          "formatter": "ST.LiquorTNT.Logging.AppJsonFormatter, ST.LiquorTNT.Logging",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
