# Every VITE_* variable is PUBLIC: it is compiled into the JavaScript bundle and readable by anyone.
# Never put a key, password, connection string or secret here. There are no secrets in a browser app.

# Base path of the API as seen from the browser. Leave "/api" so the app talks to the same origin that
# served it (the ASP.NET Core API). Only change it for a split deployment behind a reverse proxy.
VITE_API_BASE_URL=/api

# Where the Vite DEV SERVER proxies /api to (development only, not used in the production build).
VITE_DEV_API_TARGET=http://localhost:5180

# Client-side log level in production: debug | info | warn | error
VITE_LOG_LEVEL=info

# Display name shown in the title bar and login page.
VITE_APP_NAME=Excise Track & Trace
